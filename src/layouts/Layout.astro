---
import "@/styles/global.css";
import Header from "@/sections/Header/Header.astro";
import Footer from "@/sections/Footer/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
// import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  url?: string;
}

const siteUrl = "https://www.nidodegracia.org";
const {
  title = "Iglesia Bautista Reformada Nido de Gracia",
  description = "Nido de Gracia es una iglesia cristiana en Turbana, Bolívar, con predicación bíblica, adoración, doctrina reformada y comunidad de fe.",
  url = siteUrl,
} = Astro.props;

const canonicalUrl = url.startsWith("http") ? url : new URL(url, siteUrl).toString();

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Church",
  name: "Iglesia Bautista Reformada Nido de Gracia",
  url: siteUrl,
  logo: "https://www.nidodegracia.org/img/logo.webp",
  image: "https://www.nidodegracia.org/img/iglesia2.webp",
  description,
  email: "pastores@nidodegracia.org",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Finca El Nido",
    addressLocality: "Turbana",
    addressRegion: "Bolívar",
    addressCountry: "CO",
  },
  areaServed: "Turbana, Bolívar, Colombia",
  sameAs: ["https://www.nidodegracia.org"],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/img/logo.webp">
		<link rel="canonical" href={canonicalUrl} />
		<meta name="robots" content="index, follow" />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:locale" content="es_CO" />
		<meta name="theme-color" content="#0f172a" />

    <!-- Primary Meta Tags -->

		<title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Nido de Gracia" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.nidodegracia.org/img/iglesia2.webp" />

    <!-- X (Twitter) -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Vercel Speed Insights -->
    <SpeedInsights />

	</head>
	<body>
		<Header />
		<slot />
    <Footer />

	</body>
  </html>
  
  <script src="@/utils/mobile-menu.ts"></script>