---
import CerrarSVG from "@/assets/svg/CerrarSVG.astro";
import BibliaSVG from "@/assets/svg/BibliaSVG.astro";
import Correo from "@/assets/svg/Correo.astro";
import FlechaSVG from "@/assets/svg/FlechaSVG.astro";
import IglesiaSVG from "@/assets/svg/IglesiaSVG.astro";
import LogoSVG from "@/assets/svg/LogoSVG.astro";
import MenuSVG from "@/assets/svg/MenuSVG.astro";
import UsuarioSVG from "@/assets/svg/UsuariosSVG.astro";
import "./header.css";
---

<header class="navegacion">
    <nav class="navegacion__contenedor">
      <a aria-label="Ir a inicio" class="navegacion__marca" href="/">
        <LogoSVG width="80" height="80" aria-hidden="true" />
      </a>

      <ul class="navegacion__lista">
        <CerrarSVG aria-label="Cerrar menú" class="navegacion__cerrar" />
        <li class="navegacion__item"><a class="navegacion__link" href="/">Inicio</a></li>
        <!-- Submenu -->
        <li class="navegacion__item navegacion__item--posicion">
          <button class="navegacion__link nosotros">Nosotros</button>
          <FlechaSVG aria-label="Abrir submenu" class="navegacion__icono" />
          <ul class="submenu">
              <li class="prueba">
                <a class="submenu_elemento" aria-label="Ir a pastores" href="/liderazgo/">LIDERAZGO</a>
              </li>
             
              <li>
                <a class="submenu_elemento" aria-label="Ir a creencias" href="/creencias/">CREENCIAS</a>
              </li>
            </ul>
        </li>


        <!-- <li class="navegacion__item"><a class="navegacion__link" href="/predicas/">ENSEÑANZAS</a></li> -->
        <li class="navegacion__item"><a class="navegacion__link" href="/contacto/">Contacto</a></li>
        <li class="navegacion__item navegacion__item--cta">
          <a class="navegacion__seminario" href="https://ftbautista.org/" target="_blank" rel="noopener noreferrer">Seminario</a>
        </li>

        
      </ul>
      
      <MenuSVG aria-label="Abrir menú" class="navegacion__menu" />
    </nav>

    <nav class="navegacion__movil" aria-label="Navegación móvil">
      <a class="navegacion__movil-link navegacion__link" href="/">
        <IglesiaSVG width={19} height={19} aria-hidden="true" />
        <span>Inicio</span>
      </a>
      <a class="navegacion__movil-link navegacion__link" href="/creencias/">
        <BibliaSVG class="navegacion__movil-biblia" width={19} height={19} fill="currentColor" aria-hidden="true" />
        <span>Creencias</span>
      </a>
      <a class="navegacion__movil-link navegacion__link" href="/liderazgo/">
        <UsuarioSVG width={22} height={22} aria-hidden="true" />
        <span>Nosotros</span>
      </a>
      <a class="navegacion__movil-link navegacion__link" href="/contacto/">
        <Correo aria-hidden="true" width={19} height={19} fill="currentColor" />
        <span>Contacto</span>
      </a>
    </nav>
  </header>

<script src="@/utils/select-nav.ts"></script>
